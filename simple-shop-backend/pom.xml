<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      simple-shop 后端
      阶段一/二（数据层）：依据《数据库与数据层设计说明书》v1.2 §2.1 选型 / §2.2 版本说明（3.5 线）
      已定决策：DEC-DB-01（Maven）、DEC-DB-02（Spring Boot 3.5.x + Java 21 + MySQL >= 8.0.16）、
                DEC-DB-12（groupId 与包名统一为 com.simpleshop）
      阶段三（本轮）：新增 web 与 validation 两个 starter，用于 Service 层 + 卖家端 REST 接口层。
                      ⚠️ 仍不引入 JSP 相关依赖（买家端 JSP 属下一轮范围）。
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.simpleshop</groupId>
    <artifactId>simple-shop</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <!--
      打包方式：war（不是 jar）
      为什么：下一轮买家端为【服务端渲染的 JSP】（C-05、A-02、A-05），
              JSP 由 servlet 容器编译，需要 WEB-INF 下的 web 资源目录结构，
              jar 包无法承载。本轮先改打包方式，下一轮只需加
              tomcat-embed-jasper 依赖 + src/main/webapp/WEB-INF/views 目录即可。
      ⚠️ 本轮【有意保留】spring-boot-starter-web 自带的 embedded Tomcat：
         · 开发期 java -jar target/*.war 仍可直接启动（war 是「可执行 war」）
         · 也仍可 put 进外部 Tomcat 的 webapps/
         · JSP 直出需要 tomcat-embed-jasper，属下一轮的依赖，本轮不加
         → 只有【确定不再需要 java -jar 启动】时，才把 embedded Tomcat 设为 provided。
    -->
    <packaging>war</packaging>

    <name>simple-shop</name>
    <description>simple-shop 后端（数据库 / entity / repository / Service / 卖家端 REST 接口层；打包为 war 以承载下一轮买家端 JSP）</description>

    <properties>
        <!-- 技术基线固定为 Java 21（DEC-DB-02）。release 会让编译期与运行期 API 一并按 21 校验 -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- 任务 1 指定：持久化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          任务 3（业务层 + 卖家端接口层）新增：web 层。
          卖家端为前后端分离（Vue，C-06 / A-01），须提供 REST 接口契约（第 11 章 I11-01 ~ I11-16）。
          ⚠️ 本依赖会连带引入 tomcat-embed-core（servlet 容器）与 spring-webmvc；
             它**不引入** JSP 支持（tomcat-embed-jasper / jstl 是另外的依赖，本轮明确不加）——
             买家端 JSP 属下一轮范围，本轮只提供 Service。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          任务 3 新增：Bean Validation（hibernate-validator）。
          仅用于 **请求 DTO**（web/dto/*），不用于实体——
          设计说明书 DEC-DB-10 ③ 已定「实体上不加 Bean Validation 业务注解」，
          以免 @Size(max=50) 与 @Column(length=50) 形成双源不一致。
          Service 层仍须独立校验（G6-02：服务端必须独立校验前置条件，不得依赖 DTO 注解）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 任务 1 指定：MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 任务 1 指定：schema 版本化（Flyway + MySQL 方言模块，§9.1 / DEC-DB-07） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 任务 1 指定：测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          任务 6：卖家账号密码存「不可逆哈希」（C-17、DEC-06、§9.8.1）。
          这里只引入 spring-security-crypto（BCryptPasswordEncoder），
          **不引入** spring-boot-starter-security：
          后者会带来 web 安全自动配置与默认登录页，而本阶段无 web 层（§1.2），
          且引入它会让「数据层」越界到应用安全配置。
          BCrypt 编码固定 60 字符，varchar(100) 有余量（§9.2）。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- 最终包名：simple-shop.war（去掉 version，便于部署时路径稳定；不含版本号也便于容器挂载） -->
        <finalName>simple-shop</finalName>
        <plugins>
            <!--
              spring-boot-maven-plugin：把 war 打成「可执行 war」。
              打包方式为 war 时 repackage 目标默认生效：
                · MANIFEST 写入 Main-Class / Start-Class
                · 依赖放入 WEB-INF/lib-provided（外部容器部署时由容器提供）与 WEB-INF/lib
              因此同一个 war 既能 java -jar 直接跑，也能放进外部 Tomcat。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Java 版本下限：编译目标固定为 Java 21（见 maven.compiler.release），
              故构建 JDK 不得低于 21。允许更高的 JDK（如 24）构建，
              以免把「本机恰好装着 JDK 21」这一环境特征写进构建契约、妨碍换机与 CI。
              低于 21 时给出明确提示，而不是抛难以理解的编译错误。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-min-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>本项目编译目标为 Java 21（maven.compiler.release=21），构建 JDK 不得低于 21。当前 JDK 版本过低，请改用 JDK 21 或更高版本。</message>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Mockito 5 的 inline mock maker 需要 JVM agent。默认靠运行期「自附加」（self-attach），
              而本机环境禁用了 agent 附加机制，测试会以
              「It appears as if your JDK does not supply a working agent attachment mechanism」失败。
              这里按 Mockito 官方建议，把 byte-buddy-agent 作为 -javaagent 显式传给测试 JVM，
              从而不再依赖自附加。路径由 dependency-plugin 在构建期解析，不写死本机路径。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-byte-buddy-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 本工程未启用 JaCoCo，故 argLine 中不需要 @{argLine} 占位符 -->
                    <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
