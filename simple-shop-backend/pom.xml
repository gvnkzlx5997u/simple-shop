<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 技术基线：Java 21、Spring Boot 3.5.x、Spring Data JPA、MySQL 8、Flyway。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.simpleshop</groupId>
    <artifactId>simple-shop</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <!-- 保留可执行 war：既可用 java -jar 启动，也可部署到外部容器。不承载 JSP。 -->
    <packaging>war</packaging>

    <name>simple-shop</name>
    <description>simple-shop backend: REST API and image resources</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <springdoc.version>2.8.9</springdoc.version>
        <!-- 测试数据库：container = Testcontainers；local = 本机 MySQL（-Plocal-mysql）。 -->
        <simple-shop.test.database>container</simple-shop.test.database>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 仅用于请求 DTO；实体上不加校验注解，Service 层仍独立校验。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI 文档与 Swagger UI；生产环境用 SPRINGDOC_ENABLED=false 关闭。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 默认用 Testcontainers 启动一次性 MySQL；本地兜底见 local-mysql profile。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 包依赖门禁：common 隔离、controller 不碰仓储、api 不反向依赖实现、功能包无环。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

        <!-- 只引入 BCrypt，不引入 spring-boot-starter-security。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>simple-shop</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- 构建 JDK 不得低于 21。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-min-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>本项目编译目标为 Java 21，构建 JDK 不得低于 21。</message>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Mockito 需要显式把 byte-buddy-agent 传给测试 JVM，避免依赖自附加。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-byte-buddy-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- -Duser.timezone=UTC 与应用入口钉定的时区一致，兜底未来漏标注
                         @JdbcTypeCode 的新字段；值级与结构级门禁见 StorageTimeZoneTest。 -->
                    <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar} -Duser.timezone=UTC</argLine>
                    <systemPropertyVariables>
                        <simple-shop.test.database>${simple-shop.test.database}</simple-shop.test.database>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 无 Docker 或想复用本机 MySQL 时：mvn -Plocal-mysql clean verify -->
        <profile>
            <id>local-mysql</id>
            <properties>
                <simple-shop.test.database>local</simple-shop.test.database>
            </properties>
        </profile>
    </profiles>

</project>
