<?xml version="1.0" encoding="UTF-8"?>
<!--
  控制台日志沿用 Spring Boot 官方基线。
  审计日志额外输出到独立文件，按天与大小滚动，保留 90 天，时间戳使用 UTC。
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <property name="AUDIT_LOG_PATH" value="${AUDIT_LOG_PATH:-logs}"/>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${AUDIT_LOG_PATH}/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${AUDIT_LOG_PATH}/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 审计日志只写独立文件，不重复进入控制台。 -->
    <logger name="com.simpleshop.audit" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

</configuration>
