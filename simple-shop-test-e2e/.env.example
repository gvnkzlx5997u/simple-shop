# ---------------------------------------------------------------------------
# simple-shop E2E 配置模板
#
# 用法：cp .env.example .env   然后按本机情况填写（.env 已被 .gitignore 忽略）
# 优先级：真实环境变量 > .env > 代码里的默认值
#   —— CI 或临时切环境时照旧可以用 `E2E_DB_NAME=xxx npm test` 覆盖，其余项仍从 .env 读。
#
# 加载点：scripts/db.js（数据库）与 helpers/config.ts（三个地址 + 账号）各读一次，
#         两份脚本不需要再各自 export 环境变量。
# ---------------------------------------------------------------------------

# ---- 数据库：E2E 主库（npm run db:reset / db:probe 用）----
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=3306
E2E_DB_USER=root
# 本机 MySQL 口令；留空表示空口令
E2E_DB_PASSWORD=
E2E_DB_NAME=simple_shop_e2e

# ---- 买家端对账脚本（d3/d5）的夹具库，与主库分开，别混用 ----
E2E_FIXTURE_DB_NAME=simple_shop_d1

# ---- 三个服务地址（Playwright 与对账脚本共用）----
# 换成 Compose 部署形态时只改这三行：买家 /、卖家 /seller/、接口同源
API_URL=http://localhost:8080
BUYER_URL=http://localhost:5174
SELLER_URL=http://localhost:5173

# ---- 种子卖家账号（V2 迁移写入；指向别的环境时改这里）----
SELLER_ACCOUNT=seller
SELLER_PASSWORD=Abcd@1234
